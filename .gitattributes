* text=auto eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.md text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.xml text eol=lf
*.toml text eol=lf
*.properties text eol=lf
*.sh text eol=lf
gradlew text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.png binary
*.jar binary
*.dex binary
*.so binary
*.onnx binary
*.bin binary
*.dict binary
# Resource checksums depend on exact bytes, including line endings.
app/src/main/assets/** -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
app/src/main/assets/wordpacks/**/*.csv -text diff
